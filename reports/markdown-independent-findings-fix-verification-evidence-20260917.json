  "probe_program": "import json, os, subprocess, sys, tempfile\nfrom pathlib import Path\n\nROOT = Path('/home/ibis/AI/CodexSkill-pr81-ir-fixverify-20260917')\nSCRIPT = ROOT / 'skills/review-enforcer/scripts/check-markdown-whitelist-sudachi.py'\nOUT = Path('/tmp/pr81-ir-fixverify-20260917')\nFIX = OUT / 'fixture'\n(FIX / 'tools/lint').mkdir(parents=True, exist_ok=True)\n(OUT / 'logs').mkdir(parents=True, exist_ok=True)\n(FIX / 'tools/lint/markdown-targets.json').write_text(json.dumps({\n    'ignoreDirectories': ['ignored'],\n    'ignoredPrefixes': ['excluded/'],\n}, ensure_ascii=False), encoding='utf-8')\n\nrecords = []\ndef write_whitelist(term):\n    (FIX / 'tools/lint/markdown-whitelist.yaml').write_text(\n        'entries:\\n  - term: ' + term + '\\n    description: せつめい\\n', encoding='utf-8')\n\ndef run(name, args, text=None):\n    cmd = [sys.executable, str(SCRIPT), *args]\n    p = subprocess.run(cmd, cwd=FIX, input=text, text=True, capture_output=True, timeout=60)\n    (OUT / 'logs' / f'{name}.stdout.log').write_text(p.stdout, encoding='utf-8')\n    (OUT / 'logs' / f'{name}.stderr.log').write_text(p.stderr, encoding='utf-8')\n    records.append({'name':name,'exit_code':p.returncode,'stdout':p.stdout,'stderr':p.stderr})\n    return p\ndef expect(name, p, code, contains=(), excludes=()):\n    combined = p.stdout + p.stderr\n    assert p.returncode == code, (name, p.returncode, combined)\n    for token in contains:\n        assert token in combined, (name, token, combined)\n    for token in excludes:\n        assert token not in combined, (name, token, combined)\n\nwrite_whitelist('ｷﾞｱ')\nfor name, text, code in [\n    ('hw-exact', 'ｷﾞｱ', 0),\n    ('fw-from-hw-term', 'ギア', 0),\n    ('hw-suffix', 'ｷﾞｱｽ', 1),\n    ('hw-prefix', 'ﾃｽﾄｷﾞｱ', 1),\n    ('hw-mixed-suffix', 'ｷﾞｱス', 1),\n    ('hw-fw-prefix', 'テストｷﾞｱ', 1),\n    ('hw-prolonged', 'ｷﾞｱｰ', 1),\n]:\n    p = run(name, ['--stdin','probe.md'], text)\n    expect(name, p, code)\n\nwrite_whitelist('ギア')\nfor name, text, code in [('fw-exact','ギア',0),('hw-from-fw-term','ｷﾞｱ',0)]:\n    p = run(name, ['--stdin','probe.md'], text)\n    expect(name, p, code)\n# IR81-02 explicit target behavior.\nwrite_whitelist('API')\n(FIX / 'violation.md').write_text('qzxvunknownword', encoding='utf-8')\n(FIX / 'note.txt').write_text('qzxvunknownword', encoding='utf-8')\n(FIX / 'ignored').mkdir(exist_ok=True)\n(FIX / 'ignored/hidden.md').write_text('qzxvunknownword', encoding='utf-8')\n(FIX / 'excluded').mkdir(exist_ok=True)\n(FIX / 'excluded/prefix.md').write_text('qzxvunknownword', encoding='utf-8')\n(FIX / 'unsupported.json').write_text('{}', encoding='utf-8')\n(FIX / 'folder.md').mkdir(exist_ok=True)\noutside = OUT / 'outside.md'\noutside.write_text('qzxvunknownword', encoding='utf-8')\n\nexplicit = [\n    ('explicit-md', ['--files','violation.md'], 1, ('qzxvunknownword',)),\n    ('explicit-txt', ['--files','note.txt'], 1, ('qzxvunknownword',)),\n    ('missing', ['--files','missing.md'], 2, ('file does not exist',)),\n    ('ignored-dir', ['--files','ignored/hidden.md'], 2, ('excluded by Markdown target configuration',)),\n    ('ignored-prefix', ['--files','excluded/prefix.md'], 2, ('excluded by Markdown target configuration',)),\n    ('valid-plus-missing', ['--files','violation.md','missing.md'], 2, ('file does not exist',)),\n    ('unsupported', ['--files','unsupported.json'], 2, ('unsupported suffix',)),\n    ('directory', ['--files','folder.md'], 2, ('path is not a file',)),\n    ('outside', ['--files',str(outside)], 2, ('outside the repository',)),\n]\nfor name, args, code, contains in explicit:\n    p = run(name, args)\n    expect(name, p, code, contains)\n# Additional explicit-path siblings.\ntry:\n    (FIX / 'outside-link.md').symlink_to(outside)\nexcept FileExistsError:\n    pass\np = run('symlink-outside', ['--files','outside-link.md'])\nexpect('symlink-outside', p, 2, ('outside the repository',))\n\n# Regression probes for earlier findings affected by the same Python checker.\nwrite_whitelist('Tracker.DebugHost')\nfor name, text, code in [\n    ('english-approved','Tracker.DebugHost',0),\n    ('english-kanji-right','Tracker.DebugHost構成',0),\n    ('english-kanji-left','構成Tracker.DebugHost',0),\n    ('english-suffix','Tracker.DebugHostx',1),\n    ('english-dot','Tracker.DebugHost.Tracker.DebugHost',1),\n    ('english-hyphen','Tracker.DebugHost-Tracker.DebugHost',1),\n    ('english-underscore','Tracker.DebugHost_Tracker.DebugHost',1),\n    ('english-period','Tracker.DebugHost.',0),\n]:\n    p = run(name, ['--stdin','probe.md'], text)\n    expect(name, p, code)\n\nwrite_whitelist('API')\nfor name, text, code, contains in [\n    ('boundary','あ'*15999+'ギア'+'あ'*10,1,('ギア',)),\n    ('normalization-growth','㍿'*6000+'\\nジッタ',1,('probe.md:2','ジッタ')),\n    ('halfwidth-unregistered','ｺﾝﾋﾟｭｰﾀｰ',1,('ｺﾝﾋﾟｭｰﾀｰ',)),\n]:\n    p = run(name, ['--stdin','probe.md'], text)\n    expect(name, p, code, contains, ('Input is too long',))\n# Sibling observations around connector boundaries for non-ASCII whitelist values.\nwrite_whitelist('ｷﾞｱ')\nfor name, text in [\n    ('hw-dot-ascii1','ｷﾞｱ.x'),\n    ('hw-dot-asciiword','ｷﾞｱ.foo'),\n    ('ascii1-hyphen-hw','A-ｷﾞｱ'),\n    ('asciiword-hyphen-hw','ABC-ｷﾞｱ'),\n    ('hw-underscore-ascii1','ｷﾞｱ_x'),\n    ('hw-hyphen-digit','ｷﾞｱ-1'),\n]:\n    run(name, ['--stdin','probe.md'], text)\n\nsummary = {\n    'head': subprocess.check_output(['git','-C',str(ROOT),'rev-parse','HEAD'], text=True).strip(),\n    'records': records,\n}\n(OUT / 'results.json').write_text(json.dumps(summary, ensure_ascii=False, indent=2)+'\\n', encoding='utf-8')\nprint(json.dumps({\n    'head': summary['head'],\n    'record_count': len(records),\n    'connector_observations': [(r['name'],r['exit_code']) for r in records if r['name'].startswith(('hw-dot','ascii','hw-underscore','hw-hyphen'))],\n}, ensure_ascii=False))\n",
